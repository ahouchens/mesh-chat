+std::optional<TurnTcpSocketTuple> TurnPort::GetTurnTcpSocketTuple() const {
+  RTC_DCHECK_RUN_ON(const_cast<TurnPort*>(this)->thread());
+  // Read from the currently owned socket; never retain an address across
+  // allocation mismatch, socket replacement, or closure.
+  if (!ready() || SharedSocket() || GetProtocol() != PROTO_TCP ||
+      !owned_socket_ || socket_ != owned_socket_.get()) {
+    return std::nullopt;
+  }
+  TurnTcpSocketTuple tuple{socket_->GetLocalAddress(),
+                           socket_->GetRemoteAddress()};
+  if (tuple.local.port() == 0 || tuple.remote.port() == 0 ||
+      tuple.local.IsAnyIP() || tuple.remote.IsAnyIP() ||
+      tuple.local.IsUnresolvedIP() || tuple.remote.IsUnresolvedIP() ||
+      tuple.local.ipaddr().IsNil() || tuple.remote.ipaddr().IsNil()) {
+    return std::nullopt;
+  }
+  return tuple;
+}
