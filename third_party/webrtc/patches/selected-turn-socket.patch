+    if (info.key == tcp_connection) {
+      ASSERT_TRUE(info.best_connection);
+      ASSERT_TRUE(info.outer_turn_tcp_socket.has_value());
+      EXPECT_EQ(actual_tuple->local, info.outer_turn_tcp_socket->local);
+      EXPECT_EQ(actual_tuple->remote, info.outer_turn_tcp_socket->remote);
+    } else {
+      EXPECT_FALSE(info.outer_turn_tcp_socket.has_value());
+    }
+  }
+
+  ch.SwitchSelectedConnection(other_connection,
+                              IceSwitchReason::NEW_CONNECTION_FROM_LOCAL_CANDIDATE);
+  ASSERT_TRUE(ch.GetStatsForQualification(&qualified));
+  for (const ConnectionInfo& info : qualified.connection_infos) {
+    EXPECT_FALSE(info.outer_turn_tcp_socket.has_value());
+  }
+
+  // A selected connection may then be shut down. The channel removes it
+  // before the weak port is reset; the next snapshot must carry no old tuple.
+  ch.SwitchSelectedConnection(tcp_connection,
+                              IceSwitchReason::NEW_CONNECTION_FROM_LOCAL_CANDIDATE);
+  ASSERT_TRUE(tcp_connection->Shutdown());
+  ASSERT_TRUE(ch.GetStatsForQualification(&qualified));
+  for (const ConnectionInfo& info : qualified.connection_infos) {
+    EXPECT_FALSE(info.outer_turn_tcp_socket.has_value());
+  }
 }
 
