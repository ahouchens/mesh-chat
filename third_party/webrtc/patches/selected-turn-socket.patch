+  Connection* tcp_connection = nullptr;
+  Connection* other_connection = nullptr;
+  for (Connection* connection : ch.connections()) {
+    if (connection->port()->GetTurnTcpSocketTuple().has_value()) {
+      ASSERT_EQ(nullptr, tcp_connection);
+      tcp_connection = connection;
+    } else {
+      other_connection = connection;
+    }
