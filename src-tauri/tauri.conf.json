{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mesh Chat",
  "version": "0.9.66",
  "identifier": "com.meshchat.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [
      {
        "title": "Mesh Chat",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; frame-src https://www.youtube-nocookie.com https://platform.twitter.com; base-uri 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Private server-free encrypted messaging",
    "longDescription": "A security-sensitive prototype messenger using Reticulum and LXMF without required application servers.",
    "externalBin": [
      "binaries/mesh-chat-service"
    ],
    "resources": [
      "../THIRD_PARTY_NOTICES.md"
    ],
    "fileAssociations": [
      {
        "ext": [
          "meshchat",
          "meshchat-invite",
          "meshchat-connect",
          "meshchat-route"
        ],
        "mimeType": "*/*",
        "androidIntentActionFilters": [
          "view"
        ],
        "name": "Mesh Chat Invitation",
        "description": "A signed Mesh Chat invitation",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "meshchat"
          ],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": [
          "meshchat"
        ]
      }
    }
  }
}
