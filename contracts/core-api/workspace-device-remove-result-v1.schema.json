{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mesh-chat:core-api:workspace-device-remove-result:1",
  "title": "Experimental workspace device removal v1",
  "description": "Removed device handle after owner request and approval.",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "request_id", "ok", "result"],
  "properties": {
    "api_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$"},
    "ok": {"const": true},
    "result": {"$ref": "#/$defs/removed"}
  },
  "$defs": {
    "handle": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "removed": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "workspace", "device", "state"],
      "properties": {
        "profile": {"$ref": "#/$defs/handle"},
        "workspace": {"$ref": "#/$defs/handle"},
        "device": {"$ref": "#/$defs/handle"},
        "state": {"const": "removed"}
      }
    }
  }
}
