{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mesh-chat:core-api:recovery-result:1",
  "title": "Experimental snapshot and replay results v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "request_id",
    "ok",
    "result"
  ],
  "properties": {
    "api_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,80}$"
    },
    "ok": {
      "const": true
    },
    "result": {
      "oneOf": [
        {
          "$ref": "#/$defs/snapshot"
        },
        {
          "$ref": "#/$defs/replay"
        }
      ]
    }
  },
  "$defs": {
    "handle": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,128}$"
    },
    "timestamp": {
      "type": "number",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "message",
        "recipient",
        "kind",
        "text",
        "state",
        "created_at"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/handle"
        },
        "message": {
          "$ref": "#/$defs/handle"
        },
        "recipient": {
          "$ref": "#/$defs/handle"
        },
        "kind": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "state": {
          "enum": [
            "waiting_for_keys",
            "queued",
            "sending",
            "stored_for_delivery",
            "received_by_endpoint",
            "delivered",
            "expired",
            "failed",
            "cancelled"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "cursor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,1024}$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "messages",
        "next_cursor",
        "events_cursor"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/handle"
        },
        "messages": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "next_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/cursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "events_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/cursor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "next_cursor": {
              "type": "null"
            },
            "events_cursor": {
              "$ref": "#/$defs/cursor"
            }
          }
        },
        {
          "properties": {
            "next_cursor": {
              "$ref": "#/$defs/cursor"
            },
            "events_cursor": {
              "type": "null"
            }
          }
        }
      ]
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "events",
        "next_cursor",
        "more"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/handle"
        },
        "events": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "next_cursor": {
          "$ref": "#/$defs/cursor"
        },
        "more": {
          "type": "boolean"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "message",
        "type",
        "state",
        "timestamp"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/handle"
        },
        "message": {
          "$ref": "#/$defs/handle"
        },
        "type": {
          "enum": [
            "message.changed",
            "message.removed"
          ]
        },
        "state": {
          "enum": [
            "waiting_for_keys",
            "queued",
            "sending",
            "stored_for_delivery",
            "received_by_endpoint",
            "delivered",
            "expired",
            "failed",
            "cancelled",
            null
          ]
        },
        "timestamp": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "message.changed"
            },
            "state": {
              "enum": [
                "waiting_for_keys",
                "queued",
                "sending",
                "stored_for_delivery",
                "received_by_endpoint",
                "delivered",
                "expired",
                "failed",
                "cancelled"
              ]
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "message.removed"
            },
            "state": {
              "type": "null"
            }
          }
        }
      ]
    }
  }
}
