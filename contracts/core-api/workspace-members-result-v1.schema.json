{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mesh-chat:core-api:workspace-members-result:1",
  "title": "Experimental workspace member list v1",
  "description": "Caller-scoped member handles with display name, role and status only.",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "request_id", "ok", "result"],
  "properties": {
    "api_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$"},
    "ok": {"const": true},
    "result": {"$ref": "#/$defs/members"}
  },
  "$defs": {
    "handle": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "members": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "workspace", "members"],
      "properties": {
        "profile": {"$ref": "#/$defs/handle"},
        "workspace": {"$ref": "#/$defs/handle"},
        "members": {"type": "array", "maxItems": 8, "uniqueItems": true,
          "items": {"$ref": "#/$defs/member"}}
      }
    },
    "member": {
      "type": "object", "additionalProperties": false,
      "required": ["member", "display_name", "role", "status"],
      "properties": {
        "member": {"$ref": "#/$defs/handle"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "role": {"enum": ["owner", "admin", "member"]},
        "status": {"enum": ["active", "invited", "leaving", "left", "removed"]}
      }
    }
  }
}
