{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mesh-chat:core-api:workspace-device-link-preview-result:1",
  "title": "Experimental workspace device link preview v1",
  "description": "Safe preview fields for a device link; no fingerprints or keys.",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "request_id", "ok", "result"],
  "properties": {
    "api_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$"},
    "ok": {"const": true},
    "result": {"$ref": "#/$defs/preview"}
  },
  "$defs": {
    "handle": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "preview": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "workspace", "name", "member_display_name",
                   "device_count", "expires_at"],
      "properties": {
        "profile": {"$ref": "#/$defs/handle"},
        "workspace": {"$ref": "#/$defs/handle"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "member_display_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "device_count": {"type": "integer", "minimum": 1, "maximum": 24},
        "expires_at": {"type": "number", "minimum": 0, "maximum": 9007199254740991}
      }
    }
  }
}
