{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mesh-chat:core-api:workspace-join-result:1",
  "title": "Experimental workspace join result v1",
  "description": "Workspace handle and progress only; internal ids and manifests stay private.",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "request_id", "ok", "result"],
  "properties": {
    "api_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$"},
    "ok": {"const": true},
    "result": {"$ref": "#/$defs/join"}
  },
  "$defs": {
    "handle": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "join": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "workspace", "name", "state"],
      "properties": {
        "profile": {"$ref": "#/$defs/handle"},
        "workspace": {"$ref": "#/$defs/handle"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "state": {"enum": ["joining", "active", "pending", "left"]}
      }
    }
  }
}
