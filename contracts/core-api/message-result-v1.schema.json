{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mesh-chat:core-api:message-result:1",
  "title": "Experimental durable message results v1",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "request_id", "ok", "result"],
  "properties": {
    "api_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$"},
    "ok": {"const": true},
    "result": {"oneOf": [{"$ref": "#/$defs/acceptance"}, {"$ref": "#/$defs/message"}]}
  },
  "$defs": {
    "handle": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "timestamp": {"type": "number", "minimum": 0, "maximum": 9007199254740991},
    "acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "message", "accepted", "accepted_at", "idempotency_expires_at"],
      "properties": {
        "profile": {"$ref": "#/$defs/handle"}, "message": {"$ref": "#/$defs/handle"},
        "accepted": {"const": true}, "accepted_at": {"$ref": "#/$defs/timestamp"},
        "idempotency_expires_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "message": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "message", "recipient", "kind", "text", "state", "created_at"],
      "properties": {
        "profile": {"$ref": "#/$defs/handle"}, "message": {"$ref": "#/$defs/handle"},
        "recipient": {"$ref": "#/$defs/handle"}, "kind": {"const": "text"},
        "text": {"type": "string", "minLength": 1, "maxLength": 16384},
        "state": {"enum": ["waiting_for_keys", "queued", "sending", "stored_for_delivery", "received_by_endpoint", "delivered", "expired", "failed", "cancelled"]},
        "created_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
