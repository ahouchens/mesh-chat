{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mesh-chat:core-api:profile-catalog-result:1",
  "type": "object",
  "required": [
    "api_version",
    "request_id",
    "ok",
    "result"
  ],
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,80}$"
    },
    "ok": {
      "const": true
    },
    "result": {
      "type": "object",
      "required": [
        "profiles",
        "selected_profile",
        "revision"
      ],
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profile",
              "display_name",
              "selected",
              "state"
            ],
            "properties": {
              "profile": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "display_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "selected": {
                "type": "boolean"
              },
              "state": {
                "enum": [
                  "locked",
                  "unlocked",
                  "retiring"
                ]
              }
            }
          }
        },
        "selected_profile": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
