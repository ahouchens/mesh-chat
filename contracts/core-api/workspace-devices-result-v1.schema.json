{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mesh-chat:core-api:workspace-devices-result:1",
  "title": "Experimental workspace devices v1",
  "description": "Caller-scoped device handles, owning member handles and current-device flag.",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "request_id", "ok", "result"],
  "properties": {
    "api_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$"},
    "ok": {"const": true},
    "result": {"$ref": "#/$defs/devices"}
  },
  "$defs": {
    "handle": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "devices": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "workspace", "devices"],
      "properties": {
        "profile": {"$ref": "#/$defs/handle"},
        "workspace": {"$ref": "#/$defs/handle"},
        "devices": {"type": "array", "maxItems": 48, "uniqueItems": true,
          "items": {"type": "object", "additionalProperties": false,
            "required": ["device", "member", "current"],
            "properties": {
              "device": {"$ref": "#/$defs/handle"},
              "member": {"$ref": "#/$defs/handle"},
              "current": {"type": "boolean"}
            }}}
      }
    }
  }
}
