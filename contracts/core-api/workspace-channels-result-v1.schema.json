{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mesh-chat:core-api:workspace-channels-result:1",
  "title": "Experimental workspace channel list v1",
  "description": "Caller-scoped channel handles with name, visibility and state only.",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "request_id", "ok", "result"],
  "properties": {
    "api_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$"},
    "ok": {"const": true},
    "result": {"$ref": "#/$defs/channels"}
  },
  "$defs": {
    "handle": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "channels": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "workspace", "channels"],
      "properties": {
        "profile": {"$ref": "#/$defs/handle"},
        "workspace": {"$ref": "#/$defs/handle"},
        "channels": {"type": "array", "maxItems": 32, "uniqueItems": true,
          "items": {"$ref": "#/$defs/channel"}}
      }
    },
    "channel": {
      "type": "object", "additionalProperties": false,
      "required": ["channel", "name", "visibility", "state"],
      "properties": {
        "channel": {"$ref": "#/$defs/handle"},
        "name": {"type": "string", "minLength": 1, "maxLength": 64},
        "visibility": {"enum": ["public", "private"]},
        "state": {"enum": ["active", "archived", "left"]}
      }
    }
  }
}
