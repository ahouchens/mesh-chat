{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mesh-chat:core-api:workspace-invitation-create-result:1",
  "title": "Experimental workspace invitation creation v1",
  "description": "Signed workspace invitation material for out-of-band delivery.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "request_id",
    "ok",
    "result"
  ],
  "properties": {
    "api_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,80}$"
    },
    "ok": {
      "const": true
    },
    "result": {
      "$ref": "#/$defs/invitation"
    }
  },
  "$defs": {
    "handle": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,128}$"
    },
    "invitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "workspace",
        "document",
        "link",
        "expires_at"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/handle"
        },
        "workspace": {
          "$ref": "#/$defs/handle"
        },
        "document": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "link": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "expires_at": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "connection_mode": {
          "enum": [
            "webrtc",
            "email",
            "i2p",
            "participant"
          ]
        },
        "i2p_access_point": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
