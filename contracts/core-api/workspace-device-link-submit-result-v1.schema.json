{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mesh-chat:core-api:workspace-device-link-submit-result:1",
  "title": "Experimental device-link submission v1",
  "description": "A new device admits a workspace pending sponsor approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "request_id",
    "ok",
    "result"
  ],
  "properties": {
    "api_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,80}$"
    },
    "ok": {
      "const": true
    },
    "result": {
      "$ref": "#/$defs/submitted"
    }
  },
  "$defs": {
    "handle": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,128}$"
    },
    "submitted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "workspace",
        "name",
        "state"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/handle"
        },
        "workspace": {
          "$ref": "#/$defs/handle"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "state": {
          "const": "linking"
        }
      },
      "description": "linking means the workspace is admitted locally and the sponsor approval is pending"
    }
  }
}
