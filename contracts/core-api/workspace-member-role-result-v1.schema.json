{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mesh-chat:core-api:workspace-member-role-result:1",
  "title": "Experimental workspace member role change v1",
  "description": "Applied role for one caller-scoped member handle.",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "request_id", "ok", "result"],
  "properties": {
    "api_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$"},
    "ok": {"const": true},
    "result": {"$ref": "#/$defs/role"}
  },
  "$defs": {
    "handle": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "role": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "workspace", "member", "role"],
      "properties": {
        "profile": {"$ref": "#/$defs/handle"},
        "workspace": {"$ref": "#/$defs/handle"},
        "member": {"$ref": "#/$defs/handle"},
        "role": {"enum": ["admin", "member"]}
      }
    }
  }
}
