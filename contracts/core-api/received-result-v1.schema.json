{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mesh-chat:core-api:received-result:1",
  "title": "Experimental received message page v1",
  "description": "Chronological page of durable inbound chat messages. Experimental component contract; schema validity never grants authority.",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "request_id", "ok", "result"],
  "properties": {
    "api_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$"},
    "ok": {"const": true},
    "result": {"$ref": "#/$defs/page"}
  },
  "$defs": {
    "handle": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "timestamp": {"type": "number", "minimum": 0, "maximum": 9007199254740991},
    "message": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "message", "peer", "kind", "text", "state", "created_at"],
      "properties": {
        "profile": {"$ref": "#/$defs/handle"}, "message": {"$ref": "#/$defs/handle"},
        "peer": {"$ref": "#/$defs/handle"}, "kind": {"const": "text"},
        "text": {"type": "string", "minLength": 1, "maxLength": 16384},
        "state": {"enum": ["waiting_for_keys", "queued", "sending", "stored_for_delivery", "received_by_endpoint", "delivered", "expired", "failed", "cancelled"]},
        "created_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "messages", "next_cursor", "more"],
      "properties": {
        "profile": {"$ref": "#/$defs/handle"},
        "messages": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/message"}},
        "next_cursor": {"oneOf": [{"type": "string", "pattern": "^[A-Za-z0-9_-]{16,1024}$"}, {"type": "null"}]},
        "more": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"more": {"const": true}}}, "then": {"properties": {"next_cursor": {"type": "string"}}}},
        {"if": {"properties": {"more": {"const": false}}}, "then": {"properties": {"next_cursor": {"const": null}}}}
      ]
    }
  }
}
