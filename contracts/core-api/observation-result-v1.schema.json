{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mesh-chat:core-api:observation-result:1",
  "title": "Experimental public observation results v1",
  "type": "object",
  "required": ["api_version", "request_id", "ok", "result"],
  "additionalProperties": false,
  "properties": {
    "api_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$"},
    "ok": {"const": true},
    "result": {"oneOf": [{"$ref": "#/$defs/capabilities"}, {"$ref": "#/$defs/profile"}, {"$ref": "#/$defs/connection"}]}
  },
  "$defs": {
    "handle": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "handles": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/handle"}},
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["api_major", "api_minor", "stability", "operations", "profiles", "limits"],
      "properties": {
        "api_major": {"const": 1}, "api_minor": {"const": 0}, "stability": {"const": "experimental"},
        "operations": {"type": "array", "uniqueItems": true, "minItems": 3, "maxItems": 3,
          "items": {"enum": ["runtime.capabilities", "profile.query", "connection.snapshot"]}},
        "profiles": {"$ref": "#/$defs/handles"},
        "limits": {"type": "object", "additionalProperties": false,
          "required": ["frame_bytes", "profiles", "connections_per_profile"],
          "properties": {"frame_bytes": {"const": 4194304}, "profiles": {"const": 256}, "connections_per_profile": {"const": 256}}}
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "display_name", "destination", "connections"],
      "properties": {
        "profile": {"$ref": "#/$defs/handle"}, "display_name": {"type": "string", "minLength": 1, "maxLength": 80},
        "destination": {"type": "string", "pattern": "^[a-f0-9]{32}$"}, "connections": {"$ref": "#/$defs/handles"}
      }
    },
    "connection": {
      "type": "object", "additionalProperties": false, "required": ["profile", "connection", "observation"],
      "properties": {"profile": {"$ref": "#/$defs/handle"}, "connection": {"$ref": "#/$defs/handle"}, "observation": {"$ref": "#/$defs/observation"}}
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime_epoch", "sequence", "desired", "execution", "negotiation", "carrier", "bridge", "messaging_ready", "reason", "retry_in", "evidence_age"],
      "properties": {
        "runtime_epoch": {"type": "string", "minLength": 1, "maxLength": 64},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "desired": {"enum": ["enabled", "stopped"]}, "execution": {"enum": ["available", "paused", "locked", "shutting_down"]},
        "negotiation": {"enum": ["idle", "discover", "request", "wait_request", "wait_offer", "gather_offer", "gather_answer", "publish_offer", "publish_answer", "wait_answer", "apply_answer", "checking", "attach", "path", "inspect"]},
        "carrier": {"enum": ["absent", "open", "suspect", "closing"]}, "bridge": {"enum": ["detached", "attaching", "path_pending", "ready", "restoring"]},
        "messaging_ready": {"type": "boolean"}, "reason": {"type": "string", "pattern": "^[a-z][a-z_]{0,63}$"},
        "retry_in": {"type": "number", "minimum": 0}, "evidence_age": {"type": ["number", "null"], "minimum": 0}
      },
      "allOf": [{"if": {"properties": {"messaging_ready": {"const": true}}}, "then": {"properties": {
        "desired": {"const": "enabled"}, "execution": {"const": "available"}, "carrier": {"const": "open"},
        "bridge": {"const": "ready"}, "evidence_age": {"type": "number"}
      }}}]
    }
  }
}
