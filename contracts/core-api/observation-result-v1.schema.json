{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mesh-chat:core-api:observation-result:1",
  "title": "Experimental public observation results v1",
  "type": "object",
  "required": ["api_version", "request_id", "ok", "result"],
  "additionalProperties": false,
  "properties": {
    "api_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$"},
    "ok": {"const": true},
    "result": {"oneOf": [{"$ref": "#/$defs/capabilities"}, {"$ref": "#/$defs/profile"}, {"$ref": "#/$defs/connection"}, {"$ref": "#/$defs/peer"}]}
  },
  "$defs": {
    "handle": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "handles": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/handle"}},
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["api_major", "api_minor", "stability", "operations", "profiles", "limits"],
      "properties": {
        "api_major": {"const": 1}, "api_minor": {"const": 0}, "stability": {"const": "experimental"},
        "operations": {"type": "array", "uniqueItems": true, "minItems": 3, "maxItems": 15,
          "items": {"enum": ["runtime.capabilities", "profile.query", "connection.snapshot", "peer.query", "message.enqueue", "message.query", "message.list", "events.poll", "events.ack", "message.received", "connection.start", "connection.stop", "peer.approve", "peer.revoke", "diagnostics.query"]}},
        "profiles": {"$ref": "#/$defs/handles"},
        "limits": {"type": "object", "additionalProperties": false,
          "required": ["frame_bytes", "request_json_depth", "request_json_structural_tokens", "profiles", "connections_per_profile"],
          "properties": {"frame_bytes": {"const": 4194304}, "request_json_depth": {"const": 16}, "request_json_structural_tokens": {"const": 1024}, "profiles": {"const": 256}, "connections_per_profile": {"const": 256},
            "peers_per_profile": {"const": 256}, "text_utf8_bytes": {"const": 16384},
            "idempotency_seconds": {"const": 604800}, "enqueue_keys_per_caller_profile": {"const": 4096},
            "enqueue_keys_per_vault": {"const": 65536},
            "event_batch_count": {"const": 128}, "event_batch_bytes": {"const": 1048576},
            "event_retention_count": {"const": 2048}, "event_retention_seconds": {"const": 604800},
            "recovery_scan_count": {"const": 128}, "cursor_bytes": {"const": 1024},
            "acknowledgment_seconds": {"const": 604800},
            "acknowledgment_keys_per_caller_profile": {"const": 4096},
            "acknowledgment_keys_per_vault": {"const": 65536},
            "received_scan_count": {"const": 128}, "received_batch_bytes": {"const": 1048576},
            "diagnostic_count": {"const": 256}, "diagnostic_bytes": {"const": 262144}}}
      },
      "allOf": [{"if": {"properties": {"operations": {"contains": {"const": "message.enqueue"}}}},
        "then": {"properties": {"limits": {"required": ["peers_per_profile", "text_utf8_bytes", "idempotency_seconds", "enqueue_keys_per_caller_profile", "enqueue_keys_per_vault"]}}}},
        {"if": {"properties": {"operations": {"contains": {"const": "events.poll"}}}},
         "then": {"properties": {"limits": {"required": ["event_batch_count", "event_batch_bytes", "event_retention_count", "event_retention_seconds", "recovery_scan_count", "cursor_bytes", "acknowledgment_seconds", "acknowledgment_keys_per_caller_profile", "acknowledgment_keys_per_vault"]}}}},
        {"if": {"properties": {"operations": {"contains": {"const": "message.received"}}}},
         "then": {"properties": {"limits": {"required": ["received_scan_count", "received_batch_bytes"]}}}},
        {"if": {"properties": {"operations": {"contains": {"const": "diagnostics.query"}}}},
         "then": {"properties": {"limits": {"required": ["diagnostic_count", "diagnostic_bytes"]}}}}]
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "display_name", "destination", "connections"],
      "properties": {
        "profile": {"$ref": "#/$defs/handle"}, "display_name": {"type": "string", "minLength": 1, "maxLength": 80},
        "destination": {"type": "string", "pattern": "^[a-f0-9]{32}$"}, "connections": {"$ref": "#/$defs/handles"},
        "peers": {"$ref": "#/$defs/handles"}
      }
    },
    "connection": {
      "type": "object", "additionalProperties": false, "required": ["profile", "connection", "observation"],
      "properties": {"profile": {"$ref": "#/$defs/handle"}, "connection": {"$ref": "#/$defs/handle"}, "observation": {"$ref": "#/$defs/observation"}}
    },
    "peer": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "peer", "display_name", "destination", "trust"],
      "properties": {
        "profile": {"$ref": "#/$defs/handle"}, "peer": {"$ref": "#/$defs/handle"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 80},
        "destination": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "trust": {"enum": ["awaiting_consent", "pending_request", "approved", "verified", "identity_changed", "blocked"]}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime_epoch", "sequence", "desired", "execution", "negotiation", "carrier", "bridge", "messaging_ready", "reason", "retry_in", "evidence_age"],
      "properties": {
        "runtime_epoch": {"type": "string", "minLength": 1, "maxLength": 64},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "desired": {"enum": ["enabled", "stopped"]}, "execution": {"enum": ["available", "paused", "locked", "shutting_down"]},
        "negotiation": {"enum": ["idle", "discover", "request", "wait_request", "wait_offer", "gather_offer", "gather_answer", "publish_offer", "publish_answer", "wait_answer", "apply_answer", "checking", "attach", "path", "inspect"]},
        "carrier": {"enum": ["absent", "open", "suspect", "closing"]}, "bridge": {"enum": ["detached", "attaching", "path_pending", "ready", "restoring"]},
        "messaging_ready": {"type": "boolean"}, "reason": {"type": "string", "pattern": "^[a-z][a-z_]{0,63}$"},
        "retry_in": {"type": "number", "minimum": 0}, "evidence_age": {"type": ["number", "null"], "minimum": 0}
      },
      "allOf": [{"if": {"properties": {"messaging_ready": {"const": true}}}, "then": {"properties": {
        "desired": {"const": "enabled"}, "execution": {"const": "available"}, "carrier": {"const": "open"},
        "bridge": {"const": "ready"}, "evidence_age": {"type": "number"}
      }}}]
    }
  }
}
