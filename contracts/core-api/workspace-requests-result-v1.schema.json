{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mesh-chat:core-api:workspace-requests-result:1",
  "title": "Experimental join request list v1",
  "description": "Pending join requests for one workspace, without identity material.",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "request_id", "ok", "result"],
  "properties": {
    "api_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$"},
    "ok": {"const": true},
    "result": {"$ref": "#/$defs/requests"}
  },
  "$defs": {
    "handle": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "requests": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "workspace", "requests"],
      "properties": {
        "profile": {"$ref": "#/$defs/handle"},
        "workspace": {"$ref": "#/$defs/handle"},
        "requests": {"type": "array", "maxItems": 32, "uniqueItems": true,
          "items": {"$ref": "#/$defs/request"}}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["request", "display_name", "created_at"],
      "properties": {
        "request": {"$ref": "#/$defs/handle"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "created_at": {"type": "number", "minimum": 0, "maximum": 9007199254740991}
      }
    }
  }
}
