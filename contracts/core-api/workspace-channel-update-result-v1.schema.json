{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mesh-chat:core-api:workspace-channel-update-result:1",
  "title": "Experimental channel edit v1",
  "description": "Applied channel name, topic, visibility and posting override.",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "request_id", "ok", "result"],
  "properties": {
    "api_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$"},
    "ok": {"const": true},
    "result": {"$ref": "#/$defs/edit"}
  },
  "$defs": {
    "handle": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "edit": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "workspace", "channel", "name", "topic", "visibility", "posting"],
      "properties": {
        "profile": {"$ref": "#/$defs/handle"},
        "workspace": {"$ref": "#/$defs/handle"},
        "channel": {"$ref": "#/$defs/handle"},
        "name": {"type": "string", "minLength": 1, "maxLength": 64},
        "topic": {"type": "string", "maxLength": 1024},
        "visibility": {"enum": ["public", "private"]},
        "posting": {"type": ["string", "null"],
                    "enum": ["all_members", "owner_and_admins", null]}
      }
    }
  }
}
