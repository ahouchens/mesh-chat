{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mesh-chat:core-api:relationship-result:1",
  "title": "Experimental peer relationship result v1",
  "description": "Convergent approval or revocation outcome. Schema validity never grants authority.",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "request_id", "ok", "result"],
  "properties": {
    "api_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$"},
    "ok": {"const": true},
    "result": {"$ref": "#/$defs/relationship"}
  },
  "$defs": {
    "handle": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "relationship": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "peer", "trust"],
      "properties": {
        "profile": {"$ref": "#/$defs/handle"},
        "peer": {"$ref": "#/$defs/handle"},
        "trust": {"enum": ["approved", "verified", "blocked"]}
      }
    }
  }
}
