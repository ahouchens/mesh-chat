{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mesh-chat:core-api:workspace-channel-transfer-offer-result:1",
  "title": "Experimental channel transfer offer v1",
  "description": "Offered channel transfer to one caller-scoped member.",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "request_id", "ok", "result"],
  "properties": {
    "api_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$"},
    "ok": {"const": true},
    "result": {"$ref": "#/$defs/offer"}
  },
  "$defs": {
    "handle": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "offer": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "workspace", "channel", "member", "state"],
      "properties": {
        "profile": {"$ref": "#/$defs/handle"},
        "workspace": {"$ref": "#/$defs/handle"},
        "channel": {"$ref": "#/$defs/handle"},
        "member": {"$ref": "#/$defs/handle"},
        "state": {"const": "offered"}
      }
    }
  }
}
